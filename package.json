    "build:elevation": "node tools/build-elevation.mjs",
    "serve": "node tools/serve.mjs",
    "verify": "node tools/verify.mjs",
    "test": "node tools/build-content.mjs"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
