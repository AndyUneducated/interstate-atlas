{
  "name": "interstate-atlas",
  "version": "1.0.0",
  "description": "An interactive bilingual atlas of the United States highway network",
  "homepage": "https://andyuneducated.github.io/interstate-atlas/",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "fetch": "node tools/fetch-source.mjs && node tools/fetch-fhwa.mjs",
