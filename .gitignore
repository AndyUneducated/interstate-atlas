node_modules/

# Upstream source data, ~120 MB. Not committed; run `npm run fetch` to restore.
tools/src/

# Terrain tile cache used when regenerating elevation profiles.
tools/cache/

# Verification artefacts.
tools/shots/
tools/elev.log
tools/serve.pid

# Build logs and one-off diagnostic scripts. Anything under tools/ whose name
# starts with an underscore is a throwaway probe written to answer one question
# and deleted afterwards; it is never part of the pipeline.
*.log
tools/probe-*.mjs
tools/_*

# Source-checked research notes gathered while writing the route profiles. The
# citations that survived the writing are in the profiles themselves.
research/
